GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: image understanding at ingest. Gemini is tried first, then a local Ollama model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Backup LLM, used automatically when Groq fails. Leave blank to disable (all three are required).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Web search for questions the PDF does not cover (https://tavily.com). Leave blank to disable.
TAVILY_API_KEY=

# Which trained answerability gate to load from models/gate/<version>/
GATE_VERSION=v1

# Where the Streamlit UI finds the API (docker-compose sets this for you)
API_URL=http://localhost:8000
